# Kluisjesbeheer dagelijkse Magister leerling-sync (Docker)
# Beheerd door Dockerfile -- niet handmatig bewerken.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Draait elke ochtend om 06:00 als app-user (kluisjes), output naar
# container-stdout zodat het in `docker logs` zichtbaar is.
0 6 * * * kluisjes cd /opt/kluisjesbeheer/backend && /usr/local/bin/python cron_sync.py > /proc/1/fd/1 2>/proc/1/fd/2
